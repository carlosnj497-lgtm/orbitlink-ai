# ASTRYON — configuração local. Copie para .env (scripts\install.ps1 faz isso e gera o token).
# NUNCA versione o .env. Segredos ficam somente no agente/servidor do painel, nunca no navegador.

# --- Comunicação painel (Next.js) -> agente (Python). Gerado pelo install.ps1.
ASTRYON_API_TOKEN=
ASTRYON_AGENT_URL=http://127.0.0.1:8787

# --- Starlink (somente leitura por padrão)
ASTRYON_DISH_TARGET=192.168.100.1:9200
ASTRYON_ROUTER_TARGET=192.168.1.1:9000
ASTRYON_ROUTER_ENABLED=true
ASTRYON_TERMINAL_NAME="Starlink Mini"

# --- Coleta (segundos)
ASTRYON_STATUS_INTERVAL_S=10
ASTRYON_HISTORY_INTERVAL_S=30
ASTRYON_OBSTRUCTION_INTERVAL_S=300
ASTRYON_RETENTION_RAW_DAYS=7
ASTRYON_RETENTION_MINUTE_DAYS=400
ASTRYON_RETENTION_SENSOR_DAYS=30
ASTRYON_RETENTION_LOG_DAYS=90

# --- Saúde do servidor, backup e vigia
ASTRYON_DOWNTIME_NOTICE_MIN=10
# Vigia externo opcional (ex.: https://hc-ping.com/<uuid> do healthchecks.io): avisa se o servidor sumir.
ASTRYON_HEALTHCHECK_URL=
ASTRYON_HEALTHCHECK_INTERVAL_S=300
ASTRYON_BACKUP_ENABLED=true
ASTRYON_BACKUP_KEEP=14
# Cópia semanal no Telegram (desligada por padrão). Vai sem sessões, hashes de senha nem segredos, e nunca para grupo.
ASTRYON_BACKUP_TELEGRAM=false
ASTRYON_BACKUP_TELEGRAM_EVERY_DAYS=7

# --- MQTT (opcional, ex.: Home Assistant). Sem host, nada é publicado. Veja docs/HOME_ASSISTANT.md.
ASTRYON_MQTT_HOST=
ASTRYON_MQTT_PORT=1883
ASTRYON_MQTT_USERNAME=
ASTRYON_MQTT_PASSWORD=
ASTRYON_MQTT_TLS=false
ASTRYON_MQTT_TOPIC_PREFIX=astryon
ASTRYON_MQTT_DISCOVERY=true
ASTRYON_MQTT_INTERVAL_S=30

# --- Clima (opcional, Open-Meteo, gratuito e sem chave). Estimativa regional para correlacionar com a conexão.
# A localização normalmente é escolhida em Configurações; estas variáveis são só um valor inicial.
# Só as coordenadas (arredondadas a ~1 km) são enviadas à Open-Meteo. Sem localização, nada é buscado.
ASTRYON_WEATHER_ENABLED=true
ASTRYON_WEATHER_LOCATION_NAME=
ASTRYON_WEATHER_LATITUDE=
ASTRYON_WEATHER_LONGITUDE=
ASTRYON_WEATHER_INTERVAL_S=1800

# --- API do agente: loopback por padrão. Acesso pela LAN exige decisão explícita.
ASTRYON_HOST=127.0.0.1
ASTRYON_PORT=8787
ASTRYON_ALLOW_LAN=false
# Código exigido para criar o 1º administrador (obrigatório quando o painel é acessível pela LAN, ex. servidor Linux).
# O instalador Linux gera um valor aleatório e grava em /etc/astryon/setup-code. Com ASTRYON_ALLOW_LAN=true ou
# ASTRYON_APPLIANCE=true, o administrador não pode ser criado sem este código.
ASTRYON_SETUP_CODE=
# Diretório de dados (SQLite/backups). Vazio = <repo>/data. No servidor Linux: /var/lib/astryon
ASTRYON_DATA_DIR=

# --- Modo fixture (testes). Deixe vazio no uso real. Quando definido, TODO dado é marcado como demonstração.
ASTRYON_FIXTURE_FILE=

# --- ESP32 (opcional): listener separado, só rotas autenticadas por HMAC
ASTRYON_ESP32_ENABLED=false
ASTRYON_ESP32_LISTEN_HOST=0.0.0.0
ASTRYON_ESP32_LISTEN_PORT=8788

# --- Alertas (opcional): webhook HTTPS recebe apenas severidade + mensagem genérica
ASTRYON_ALERT_WEBHOOK_URL=
# Telegram (opcional): crie um bot com o @BotFather, mande uma mensagem a ele e descubra o chat com
#   python -m astryon_agent telegram-chat-id   (no servidor Linux: sudo astryonctl telegram-chat-id)
ASTRYON_TELEGRAM_BOT_TOKEN=
ASTRYON_TELEGRAM_CHAT_ID=
# Se o chat acima for um GRUPO, só estes usuários (id numérico do Telegram) usam o bot. Ex.: [123456789]
ASTRYON_TELEGRAM_ALLOWED_USER_IDS=[]
# O bot também responde perguntas (copiloto/Groq), só vindas do chat acima. Busca as mensagens no Telegram
# (long polling): nenhuma porta aberta. false = só envia alertas.
ASTRYON_TELEGRAM_CHAT_ENABLED=true
ASTRYON_TELEGRAM_CHAT_PER_MINUTE=6
# Notificação que não sai em N horas (ex.: internet fora) é descartada
ASTRYON_NOTIFICATION_MAX_AGE_H=24
# Resumo semanal pelo Telegram (consumo, disponibilidade, quedas, franquia). Ajustável em Alertas, que tem prioridade.
# Dia: 0 = segunda ... 6 = domingo. Hora local (ASTRYON_TIMEZONE). Cobre os 7 dias completos antes do dia do envio.
ASTRYON_WEEKLY_DIGEST_ENABLED=true
ASTRYON_WEEKLY_DIGEST_WEEKDAY=0
ASTRYON_WEEKLY_DIGEST_HOUR=8
# Relatório do ciclo em PDF pelo Telegram, no dia seguinte ao fim do ciclo da franquia (9h).
ASTRYON_MONTHLY_REPORT_ENABLED=true

# --- Franquia do plano (opcional; também ajustável em Configurações, que tem prioridade)
# Comparada ao consumo ESTIMADO localmente. Alertas em 80% e 100% do ciclo. A fatura oficial pode diferir.
ASTRYON_USAGE_MONTHLY_LIMIT_GB=
ASTRYON_USAGE_CYCLE_START_DAY=1

# --- Supabase (opcional). Use SOMENTE a anon key + token do agente (gerado no pareamento). Nunca a service_role.
ASTRYON_SUPABASE_URL=
ASTRYON_SUPABASE_ANON_KEY=
ASTRYON_SUPABASE_AGENT_TOKEN=
# Painel (login na nuvem / visão remota) — valores públicos por natureza
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Assistente de IA via Groq (opcional). Sem chave, o assistente usa diagnóstico por regras.
# Chave em https://console.groq.com/keys. Modelos com ferramentas: openai/gpt-oss-120b, openai/gpt-oss-20b.
ASTRYON_GROQ_API_KEY=
ASTRYON_AI_MODEL=openai/gpt-oss-120b
ASTRYON_AI_DAILY_REQUEST_LIMIT=100
ASTRYON_AI_CONVERSATION_RETENTION_DAYS=30

# --- Áudio (nota de voz do Telegram) — opcional. Usa a MESMA chave da Groq (Whisper).
# O bot transcreve a nota de voz e responde como se fosse texto. O áudio não é salvo em disco.
ASTRYON_AI_TRANSCRIBE_ENABLED=true
ASTRYON_AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
ASTRYON_AI_TRANSCRIBE_LANGUAGE=pt
ASTRYON_AI_TRANSCRIBE_TIMEOUT_S=60
# Cota própria de áudios por dia (a cota de texto conta tokens; a de áudio conta requisições).
ASTRYON_AI_AUDIO_DAILY_REQUEST_LIMIT=50
# Tamanho máximo aceito por nota de voz (o Telegram envia Opus em .ogg).
ASTRYON_AI_AUDIO_MAX_BYTES=20971520

# --- Exibição
ASTRYON_TIMEZONE=America/Fortaleza
# true somente se o painel for servido via HTTPS
ASTRYON_COOKIE_SECURE=false
