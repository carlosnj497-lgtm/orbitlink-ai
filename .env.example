# OrbitLink AI — configuração local. Copie para .env (scripts\install.ps1 faz isso e gera o token).
# NUNCA versione o .env. Segredos ficam somente no agente/servidor do painel, nunca no navegador.

# --- Comunicação painel (Next.js) -> agente (Python). Gerado pelo install.ps1.
ORBITLINK_API_TOKEN=
ORBITLINK_AGENT_URL=http://127.0.0.1:8787

# --- Starlink (somente leitura por padrão)
ORBITLINK_DISH_TARGET=192.168.100.1:9200
ORBITLINK_ROUTER_TARGET=192.168.1.1:9000
ORBITLINK_ROUTER_ENABLED=true
ORBITLINK_TERMINAL_NAME="Starlink Mini"

# --- Coleta (segundos)
ORBITLINK_STATUS_INTERVAL_S=10
ORBITLINK_HISTORY_INTERVAL_S=30
ORBITLINK_OBSTRUCTION_INTERVAL_S=300
ORBITLINK_RETENTION_RAW_DAYS=7
ORBITLINK_RETENTION_MINUTE_DAYS=400
ORBITLINK_RETENTION_SENSOR_DAYS=30
ORBITLINK_RETENTION_LOG_DAYS=90

# --- API do agente: loopback por padrão. Acesso pela LAN exige decisão explícita.
ORBITLINK_HOST=127.0.0.1
ORBITLINK_PORT=8787
ORBITLINK_ALLOW_LAN=false
# Código exigido para criar o 1º administrador (obrigatório quando o painel é acessível pela LAN, ex. servidor Linux).
# O instalador Linux gera um valor aleatório e grava em /etc/orbitlink/setup-code.
ORBITLINK_SETUP_CODE=
# Diretório de dados (SQLite/backups). Vazio = <repo>/data. No servidor Linux: /var/lib/orbitlink
ORBITLINK_DATA_DIR=

# --- Modo fixture (testes). Deixe vazio no uso real. Quando definido, TODO dado é marcado como demonstração.
ORBITLINK_FIXTURE_FILE=

# --- ESP32 (opcional): listener separado, só rotas autenticadas por HMAC
ORBITLINK_ESP32_ENABLED=false
ORBITLINK_ESP32_LISTEN_HOST=0.0.0.0
ORBITLINK_ESP32_LISTEN_PORT=8788

# --- Alertas (opcional): webhook HTTPS recebe apenas severidade + mensagem genérica
ORBITLINK_ALERT_WEBHOOK_URL=
# Telegram (opcional): crie um bot com o @BotFather, mande uma mensagem a ele e descubra o chat com
#   python -m orbitlink_agent telegram-chat-id   (no servidor Linux: sudo orbitlinkctl telegram-chat-id)
ORBITLINK_TELEGRAM_BOT_TOKEN=
ORBITLINK_TELEGRAM_CHAT_ID=
# O bot também responde perguntas (copiloto/Groq), só vindas do chat acima. Busca as mensagens no Telegram
# (long polling): nenhuma porta aberta. false = só envia alertas.
ORBITLINK_TELEGRAM_CHAT_ENABLED=true
ORBITLINK_TELEGRAM_CHAT_PER_MINUTE=6
# Notificação que não sai em N horas (ex.: internet fora) é descartada
ORBITLINK_NOTIFICATION_MAX_AGE_H=24
# Resumo semanal pelo Telegram (consumo, disponibilidade, quedas, franquia). Ajustável em Alertas, que tem prioridade.
# Dia: 0 = segunda ... 6 = domingo. Hora local (ORBITLINK_TIMEZONE). Cobre os 7 dias completos antes do dia do envio.
ORBITLINK_WEEKLY_DIGEST_ENABLED=true
ORBITLINK_WEEKLY_DIGEST_WEEKDAY=0
ORBITLINK_WEEKLY_DIGEST_HOUR=8

# --- Franquia do plano (opcional; também ajustável em Configurações, que tem prioridade)
# Comparada ao consumo ESTIMADO localmente. Alertas em 80% e 100% do ciclo. A fatura oficial pode diferir.
ORBITLINK_USAGE_MONTHLY_LIMIT_GB=
ORBITLINK_USAGE_CYCLE_START_DAY=1

# --- Supabase (opcional). Use SOMENTE a anon key + token do agente (gerado no pareamento). Nunca a service_role.
ORBITLINK_SUPABASE_URL=
ORBITLINK_SUPABASE_ANON_KEY=
ORBITLINK_SUPABASE_AGENT_TOKEN=
# Painel (login na nuvem / visão remota) — valores públicos por natureza
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Assistente de IA via Groq (opcional). Sem chave, o assistente usa diagnóstico por regras.
# Chave em https://console.groq.com/keys. Modelos com ferramentas: openai/gpt-oss-120b, openai/gpt-oss-20b.
ORBITLINK_GROQ_API_KEY=
ORBITLINK_AI_MODEL=openai/gpt-oss-120b
ORBITLINK_AI_DAILY_REQUEST_LIMIT=100
ORBITLINK_AI_CONVERSATION_RETENTION_DAYS=30

# --- Áudio (nota de voz do Telegram) — opcional. Usa a MESMA chave da Groq (Whisper).
# O bot transcreve a nota de voz e responde como se fosse texto. O áudio não é salvo em disco.
ORBITLINK_AI_TRANSCRIBE_ENABLED=true
ORBITLINK_AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
ORBITLINK_AI_TRANSCRIBE_LANGUAGE=pt
ORBITLINK_AI_TRANSCRIBE_TIMEOUT_S=60
# Cota própria de áudios por dia (a cota de texto conta tokens; a de áudio conta requisições).
ORBITLINK_AI_AUDIO_DAILY_REQUEST_LIMIT=50
# Tamanho máximo aceito por nota de voz (o Telegram envia Opus em .ogg).
ORBITLINK_AI_AUDIO_MAX_BYTES=20971520

# --- Exibição
ORBITLINK_TIMEZONE=America/Fortaleza
# true somente se o painel for servido via HTTPS
ORBITLINK_COOKIE_SECURE=false
