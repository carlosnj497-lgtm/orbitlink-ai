#!/usr/bin/env bash
# astryonctl — operação do ASTRYON no servidor Linux.
set -euo pipefail
if [[ -f /usr/local/lib/astryon/lib.sh ]]; then
  . /usr/local/lib/astryon/lib.sh
else
  . "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
fi

usage() {
  cat <<'EOF'
Uso: sudo astryonctl <comando> [opções]

Serviços
  start | stop | restart [agent|web|all]   Controla os serviços (padrão: all)
  status                                   Estado dos serviços, timers e verificação rápida de saúde
  logs [agent|web|nginx|backup] [-f] [--since "1 hour ago"]   Logs via journalctl
  health                                   Testa agente, painel, Nginx e portas (exit 0 = saudável)

Diagnóstico
  diagnose [--json] [--share] [--no-router]   Diagnóstico da rede/antena (somente leitura)
  doctor                                   Saúde + diagnóstico + erros recentes + checagens de segurança

Manutenção
  update [--git-pull] [--source DIR]       Nova release com rollback automático (código copiado para /opt/astryon/src)
  rollback                                 Volta para a release anterior
  backup                                   Backup online do SQLite agora
  restore ARQUIVO.sqlite3.gz               Restaura um backup (para o agente durante a troca)
  recover-admin --username USUARIO        Recupera administrador sem senha de backup sanitizado
  releases                                 Lista releases instaladas
  setup-code                               Mostra o código para criar o primeiro administrador
  renew-cert [--force]                     Renova o certificado HTTPS autoassinado (automático com < 30 dias)
  esp32 enable|disable                     Liga/desliga o listener ESP32 (porta 8788, somente LAN)
  supabase-token --email E-MAIL            Gera token do agente + SQL (só o hash vai ao Supabase)
  telegram-chat-id                         Mostra o chat_id do Telegram (envie uma mensagem ao bot antes)
  version
EOF
}

units_for() {
  case "${1:-all}" in
    agent) echo astryon-agent.service ;;
    web) echo astryon-web.service ;;
    all|"") echo astryon-agent.service astryon-web.service ;;
    *) die "serviço desconhecido: $1 (use agent, web ou all)" ;;
  esac
}

agent_py() { echo "${OL_CURRENT}/apps/agent/.venv/bin/python"; }

run_agent_cli() {
  # Executa a CLI do agente como o usuário de serviço. O próprio agente lê o arquivo de ambiente
  # (ASTRYON_ENV_FILE, mesmo formato do EnvironmentFile do systemd); ele NUNCA é executado pelo bash, então um
  # valor com $(...) ou crases (uma senha, por exemplo) continua sendo só texto.
  runuser -u "${OL_USER}" -- env -C "${OL_DATA}" ASTRYON_ENV_FILE="${OL_ENV_FILE}" ASTRYON_DATA_DIR="${OL_DATA}" \
    ASTRYON_SECRETS_KEY_FILE="${OL_ETC}/secrets.key" HOME="${OL_DATA}" "$(agent_py)" -m astryon_agent "$@"
}

cmd_health() {
  local rc=0
  for u in "${OL_SERVICES[@]}" nginx.service; do
    if systemctl is-active --quiet "${u}"; then ok "${u} ativo"; else warn "${u} NÃO está ativo"; rc=1; fi
  done
  health_check 3 || rc=1
  if nginx -t >/dev/null 2>&1; then ok "configuração do Nginx válida"; else warn "nginx -t falhou"; rc=1; fi
  # Segurança: agente e painel não podem escutar fora do loopback
  local exposed
  exposed="$(ss -Hltn '( sport = :8787 or sport = :3000 )' | awk '{print $4}' | grep -vE '^(127\.0\.0\.1|\[::1\]):' || true)"
  if [[ -n "${exposed}" ]]; then warn "porta administrativa exposta fora do loopback: ${exposed}"; rc=1; else ok "8787 e 3000 escutam só em loopback"; fi
  if ufw status 2>/dev/null | grep -q "Status: active"; then ok "UFW ativo"; else warn "UFW inativo"; fi
  local free; free="$(df -P "${OL_DATA}" | awk 'NR==2 {print $4}')"
  if (( free > 1048576 )); then ok "espaço livre em ${OL_DATA}: $((free / 1024)) MB"
  else warn "pouco espaço em ${OL_DATA}: $((free / 1024)) MB"; rc=1; fi
  return "${rc}"
}

cmd_status() {
  systemctl --no-pager --lines=0 status astryon.target "${OL_SERVICES[@]}" nginx.service || true
  echo
  systemctl --no-pager list-timers astryon-backup.timer || true
  echo
  info "release ativa: $(basename "$(current_release)")"
  cmd_health || true
}

cmd_logs() {
  local which="${1:-agent}"; shift || true
  local unit
  case "${which}" in
    agent) unit=astryon-agent.service ;;
    web) unit=astryon-web.service ;;
    nginx) unit=nginx.service ;;
    backup) unit=astryon-backup.service ;;
    all) exec journalctl -u astryon-agent -u astryon-web -u nginx --no-pager "$@" ;;
    *) die "use: logs agent|web|nginx|backup|all" ;;
  esac
  exec journalctl -u "${unit}" --no-pager -n 200 "$@"
}

cmd_doctor() {
  step "Saúde dos serviços"; cmd_health || true
  step "Rota até a antena"
  ip route get 192.168.100.1 2>/dev/null | sed 's/^/    /' || warn "sem rota"
  for t in 192.168.100.1:9200 192.168.1.1:9000; do
    if timeout 3 bash -c "</dev/tcp/${t%:*}/${t#*:}" 2>/dev/null; then ok "TCP ${t} acessível"; else warn "TCP ${t} sem resposta"; fi
  done
  step "Diagnóstico do agente"
  run_agent_cli diagnose || true
  step "Erros e avisos recentes (1 h)"
  journalctl -u astryon-agent -u astryon-web -p warning --since "1 hour ago" --no-pager -n 30 || true
  step "Reinícios registrados pelo systemd"
  for u in "${OL_SERVICES[@]}"; do info "${u}: NRestarts=$(systemctl show -p NRestarts --value "${u}")"; done
  step "Permissões sensíveis"
  stat -c '    %A %U:%G %n' "${OL_ENV_FILE}" "${OL_ETC}/secrets.key" "${OL_ETC}/setup-code" "${OL_DATA}" 2>/dev/null || true
  step "Certificado HTTPS"
  local left; left="$(cert_days_left "${OL_TLS}/astryon.crt")"
  if [[ -z "${left}" ]]; then warn "certificado ilegível ou ausente"
  elif (( left < 30 )); then warn "certificado expira em ${left} dias: sudo astryonctl renew-cert"
  else ok "certificado válido por mais ${left} dias"; fi
}

cmd_rollback() {
  local prev; prev="$(previous_release)"
  [[ -n "${prev}" ]] || die "não há release anterior válida"
  step "Rollback para $(basename "${prev}")"
  switch_release "${prev}"
  systemctl restart "${OL_SERVICES[@]}"
  if health_check 40; then ok "rollback concluído"; else die "a release anterior também não respondeu (sudo astryonctl doctor)"; fi
}

cmd_restore() {
  local file="${1:?informe o arquivo .sqlite3.gz}"
  [[ -f "${file}" ]] || die "arquivo não encontrado: ${file}"
  gzip -t "${file}" || die "arquivo gzip inválido"
  confirm "Restaurar ${file}? O banco atual será guardado como .antes-da-restauracao" || die "cancelado"
  systemctl stop astryon-agent.service
  # Só o root LÊ o backup; tudo dentro de ${OL_DATA} (pasta do usuário de serviço) é feito COMO esse usuário.
  # Assim um link simbólico plantado lá não faz o root sobrescrever nem mudar o dono de arquivos do sistema.
  # shellcheck disable=SC2016  # $1/$2 são expandidos pelo bash interno
  gunzip -c "${file}" | runuser -u "${OL_USER}" -- bash -c '
    set -euo pipefail; umask 027; db="$1"
    tmp="$(mktemp "${db}.restaurando.XXXXXX")"
    cat > "${tmp}"
    sqlite3 "${tmp}" "PRAGMA integrity_check;" | grep -qx ok || { rm -f "${tmp}"; echo "integrity_check falhou" >&2; exit 3; }
    if [[ -e "${db}" ]]; then mv -fT "${db}" "${db}.antes-da-restauracao-$(date +%s)"; fi
    rm -f "${db}-wal" "${db}-shm"
    mv -fT "${tmp}" "${db}"
  ' _ "${OL_DATA}/astryon.sqlite3" || { systemctl start astryon-agent.service; die "restauração abortada; banco atual mantido"; }
  systemctl start astryon-agent.service
  if health_check 40; then ok "restaurado"; else warn "agente não respondeu após restaurar"; fi
}

cmd_renew_cert() {
  # Renova o certificado autoassinado quando faltam menos de 30 dias (ou sempre, com --force).
  local force=0 left
  [[ "${1:-}" == "--force" ]] && force=1
  left="$(cert_days_left "${OL_TLS}/astryon.crt")"
  if [[ ${force} -eq 0 && -n "${left}" && ${left} -gt 30 ]]; then ok "certificado válido por mais ${left} dias"; return 0; fi
  local cn; cn="$(openssl x509 -noout -subject -nameopt multiline -in "${OL_TLS}/astryon.crt" 2>/dev/null \
    | sed -n 's/^ *commonName *= *//p')"
  cert_create "${cn:-$(hostname)}" "$(cert_san "${cn}")" || die "não foi possível gerar o certificado"
  ok "novo certificado autoassinado (825 dias); o navegador vai pedir para aceitar de novo"
  if nginx -t >/dev/null 2>&1; then systemctl reload nginx; fi
}

cmd_esp32() {
  local action="${1:?use: esp32 enable|disable}"
  local lan; lan="$(lan_cidr)"
  case "${action}" in
    enable)
      env_set ASTRYON_ESP32_ENABLED true
      [[ -n "${lan}" ]] && ufw allow from "${lan}" to any port 8788 proto tcp comment 'astryon: esp32 lan' >/dev/null
      ok "ESP32 habilitado (porta 8788 liberada só para ${lan:-<LAN não detectada>})" ;;
    disable)
      env_set ASTRYON_ESP32_ENABLED false
      if [[ -n "${lan}" ]]; then
        ufw delete allow from "${lan}" to any port 8788 proto tcp >/dev/null 2>&1 || true  # regra pode não existir
      fi
      ok "ESP32 desabilitado e porta 8788 fechada" ;;
    *) die "use: esp32 enable|disable" ;;
  esac
  systemctl restart astryon-agent.service
}

main() {
  local cmd="${1:-}"; shift || true
  case "${cmd}" in
    start|stop|restart)
      require_root
      # shellcheck disable=SC2046
      systemctl "${cmd}" $(units_for "${1:-all}")
      [[ "${cmd}" == "stop" ]] || health_check 40 ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    health) cmd_health ;;
    diagnose) require_root; run_agent_cli diagnose "$@" ;;
    doctor) require_root; cmd_doctor ;;
    update) require_root; exec /usr/local/lib/astryon/update.sh "$@" ;;
    rollback) require_root; cmd_rollback ;;
    backup) require_root; runuser -u "${OL_USER}" -- env ASTRYON_DATA_DIR="${OL_DATA}" "${OL_LIBEXEC}/backup.sh" ;;
    restore) require_root; cmd_restore "$@" ;;
    recover-admin) require_root; run_agent_cli recover-admin "$@" ;;
    releases) ls -1t "${OL_RELEASES}"; info "ativa: $(basename "$(current_release)")" ;;
    setup-code) require_root; cat "${OL_ETC}/setup-code" ;;
    renew-cert) require_root; cmd_renew_cert "$@" ;;
    esp32) require_root; cmd_esp32 "$@" ;;
    supabase-token) require_root; run_agent_cli supabase-token "$@" ;;
    telegram-chat-id) require_root; run_agent_cli telegram-chat-id ;;
    version) "$(agent_py)" -c "import astryon_agent; print('astryon-agent', astryon_agent.__version__)"; info "release $(basename "$(current_release)")" ;;
    ""|-h|--help|help) usage ;;
    *) usage; die "comando desconhecido: ${cmd}" ;;
  esac
}

main "$@"
