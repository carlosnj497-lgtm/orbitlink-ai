[Unit]
Description=OrbitLink AI - backup online do SQLite local
After=orbitlink-agent.service

[Service]
Type=oneshot
User=orbitlink
Group=orbitlink
UMask=0077
ExecStart=/usr/local/lib/orbitlink/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/orbitlink
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
SyslogIdentifier=orbitlink-backup
