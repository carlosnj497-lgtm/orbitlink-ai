# URL pública do backend usada pelo app mobile
PUBLIC_API_URL=http://localhost:8000/api/v1

# Origens permitidas no CORS (lista separada por vírgula; "*" libera todas)
ASTRYON_CORS_ORIGINS=*

# Token opcional para as rotas de leitura agregada (/devices, /summary e
# /devices/{id}/telemetry). Vazio mantém o acesso aberto (protótipo).
ASTRYON_ADMIN_TOKEN=

# Atualização do app mobile. Coloque o APK em backend/releases/ e o backend
# publica o manifesto em /api/v1/app/latest.
ASTRYON_APK_DIR=releases
# Versão exibida no manifesto (vazio = deduz do nome do arquivo, ex. astryon-1.2.3.apk)
ASTRYON_APP_VERSION=
ASTRYON_APP_NOTES=
# URL pública base atrás do proxy/Caddy (vazio = infere do request)
ASTRYON_PUBLIC_URL=
# Manifesto remoto (ex.: latest.json de uma GitHub Release). Quando definido,
# tem prioridade sobre os APKs locais e o backend faz o proxy do download.
# Ex.: https://github.com/DONO/REPO/releases/latest/download/latest.json
ASTRYON_RELEASE_MANIFEST_URL=

# Para rodar em produção, configure HTTPS, mTLS e variáveis de segredo
SECRET_KEY=mude-essa-chave-em-producao
